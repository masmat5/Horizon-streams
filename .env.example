# Copy to .env.local (dev) or set these in the Hostinger Node.js app's environment settings.

# MySQL (Hostinger: hPanel > Databases > MySQL Databases; host is usually localhost)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin login (one admin). Make the hash with:  npm run admin:hash -- "your password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random 32+ character string used to sign the login cookie, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public site address (used in the sitemap)
SITE_URL=https://horizonstreamiptv.com

# Optional: where uploaded images are stored (default ./uploads). Keep it OUTSIDE the deploy folder if redeploys wipe it.
# UPLOAD_DIR=
